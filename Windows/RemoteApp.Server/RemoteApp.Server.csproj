<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows server: shares one app window with a RemoteApp client. Captures
       the desktop region of the window with DXGI Desktop Duplication, encodes
       H.264 with a Media Foundation encoder (hardware when available), injects
       input with SendInput, and listens with TLS on the tailnet + loopback.
       Win32 interop is generated by CsWin32 from NativeMethods.txt. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RemoteApp.Server</RootNamespace>
    <AssemblyName>RemoteAppServer</AssemblyName>
    <StartupObject>RemoteApp.Server.Program</StartupObject>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363" PrivateAssets="all" />
    <ProjectReference Include="..\RemoteApp.Protocol\RemoteApp.Protocol.csproj" />
    <ProjectReference Include="..\RemoteApp.WindowsCommon\RemoteApp.WindowsCommon.csproj" />
  </ItemGroup>
</Project>
