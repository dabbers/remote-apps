<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows client: shows a remote app as a "virtual" application window on
       this PC. Decodes with Media Foundation, renders with Direct2D, and maps
       mouse/keyboard to the protocol's input events. Win32 interop is generated
       by CsWin32 from NativeMethods.txt. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RemoteApp.Client</RootNamespace>
    <AssemblyName>RemoteAppClient</AssemblyName>
    <StartupObject>RemoteApp.Client.Program</StartupObject>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363" PrivateAssets="all" />
    <ProjectReference Include="..\RemoteApp.Protocol\RemoteApp.Protocol.csproj" />
    <ProjectReference Include="..\RemoteApp.WindowsCommon\RemoteApp.WindowsCommon.csproj" />
  </ItemGroup>
</Project>
